.PHONY: all build build-clib install uninstall clean distclean

# Default configuration
PREFIX ?= /usr/local
BINDIR = $(PREFIX)/bin
LIBDIR = $(PREFIX)/lib
PROJECT_DIR = liyh
BINARY_NAME = liyh
CLIB_SOURCE = $(PROJECT_DIR)/C/rcl.c

# --- OS & Architecture Detection ---
UNAME_S := $(shell uname -s)
ARCH := $(shell uname -m)

# Defaults for Linux
LIB_EXT = .so
RID_OS = linux
SHARED_FLAG = -shared

# Overrides for macOS (Darwin)
ifeq ($(UNAME_S),Darwin)
	LIB_EXT = .dylib
	RID_OS = osx
	SHARED_FLAG = -dynamiclib
endif

CLIB_NAME = librcl$(LIB_EXT)

# Map Architecture to .NET RID
ifeq ($(ARCH),x86_64)
	RID_ARCH = x64
else ifneq (,$(filter $(ARCH),arm64 aarch64))
	RID_ARCH = arm64
endif

RID = $(RID_OS)-$(RID_ARCH)
BUILD_OUTPUT = $(PROJECT_DIR)/bin/Release/net9.0/$(RID)/publish
# -----------------------------------

# Load configuration generated by install.sh
-include .compiler_config

# Fallback values
CC ?= cc
DOTNET_PATH ?= dotnet

all: build

build-clib:
	@echo "Building C library ($(CLIB_NAME))..."
	@$(CC) $(SHARED_FLAG) -o $(PROJECT_DIR)/$(CLIB_NAME) $(CLIB_SOURCE) -lgc -lffi -lm -fPIC -O3 $(EXTRA_CFLAGS) $(EXTRA_LDFLAGS)

build: build-clib
	@echo "Building .NET project for $(RID) (ReadyToRun)..."
	@cd $(PROJECT_DIR) && "$(DOTNET_PATH)" publish -c Release -r $(RID) \
		--self-contained true \
		-p:PublishReadyToRun=true \
		-o bin/Release/net9.0/$(RID)/publish > /dev/null
	@cp $(PROJECT_DIR)/$(CLIB_NAME) $(BUILD_OUTPUT)/$(CLIB_NAME)
	@echo "Build complete."

install:
	@if [ ! -f $(BUILD_OUTPUT)/$(BINARY_NAME) ]; then \
		echo "Error: Binary not found. Please run 'make' first."; \
		exit 1; \
	fi
	@echo "Installing binaries to $(DESTDIR)$(BINDIR)..."
	@install -m 755 $(BUILD_OUTPUT)/$(BINARY_NAME) $(DESTDIR)$(BINDIR)/$(BINARY_NAME)
	@echo "Installing library to $(DESTDIR)$(LIBDIR)..."
	@install -m 755 $(BUILD_OUTPUT)/$(CLIB_NAME) $(DESTDIR)$(LIBDIR)/$(CLIB_NAME)
	
	@# Update shared library cache (Linux only)
	@if [ -z "$(DESTDIR)" ] && [ "$(UNAME_S)" != "Darwin" ] && command -v ldconfig >/dev/null; then \
		ldconfig || echo "Warning: Could not run ldconfig."; \
	fi
	@echo "Installation successful."

uninstall:
	@rm -f $(DESTDIR)$(BINDIR)/$(BINARY_NAME)
	@rm -f $(DESTDIR)$(LIBDIR)/librcl.so
	@rm -f $(DESTDIR)$(LIBDIR)/librcl.dylib
	@if [ -z "$(DESTDIR)" ] && [ "$(UNAME_S)" != "Darwin" ] && command -v ldconfig >/dev/null; then \
		ldconfig || true; \
	fi
	@echo "Uninstallation complete."

clean:
	@echo "Cleaning build artifacts..."
	@cd $(PROJECT_DIR) && "$(DOTNET_PATH)" clean >/dev/null 2>&1 || true
	@rm -rf $(PROJECT_DIR)/bin $(PROJECT_DIR)/obj
	@rm -f $(PROJECT_DIR)/$(CLIB_NAME)

distclean: clean
	@echo "Removing configuration and local dependencies..."
	@rm -f .compiler_config
	@rm -rf .dotnet_internal

