  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="C/rcl.c" />
  </ItemGroup>

  <PropertyGroup>
      <NoWarn>NU1701</NoWarn>
  </PropertyGroup>

</Project>
