    <Compile Include="Utils/ColorTerm.fs" />
    <Compile Include="Utils/ErrorReport.fs" />

    <Compile Include="Syntax/Indentation.fs" />
    <Compile Include="Syntax/SyntaxTree.fs" />
    <Compile Include="Syntax/Mixfix.fs" />
    <Compile Include="Syntax/Parser.fs" />
    <Compile Include="Syntax/PrettyPrint.fs" />

    <Compile Include="ModuleSystem/Module.fs" />
    <Compile Include="ModuleSystem/Definition.fs" />
    <Compile Include="ModuleSystem/LiyhPackage.fs" />

    <Compile Include="Typecheck/TypeCheck.fs" />

    <Compile Include="FFI/C/CFFI.fs" />

    <Compile Include="Core/Core.fs" />
    <Compile Include="Core/Helper.fs" />
    <Compile Include="Core/Substitution.fs" />
    <Compile Include="Core/Builtin.fs" />
    <Compile Include="Core/PrettyPrinter.fs" />
    <Compile Include="Core/DecisionTree/DecisionTree.fs" />
    <Compile Include="Core/DecisionTree/DecisionTreeCompiler.fs" />
    <Compile Include="Core/DecisionTree/DecisionTreePrettyPrinter.fs" />
    <Compile Include="Core/Compiler/AlphaConversion.fs" />
    <Compile Include="Core/Compiler/CoreCompiler.fs" />
