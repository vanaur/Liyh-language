--| Tests for mutable variables (var/<-), while loops, for..to, for..downto, for..in, and low-level buffers. --|

use TSL
use Tests.Framework

export imperative_tests


imp_sqrt[s: Float, precision: Float]: Float ->
    var x = s
    var running = true
    while running do
        let next = 0.5 * (x + (s / x))
        if abs[x - next] < precision then
            running <- false
        else
            x <- next
    x

test_imp_var_and_while[]: Result[Unit, String] ->
    var count = 0
    var total = 1
    while count < 5 do
        total <- total * 2
        count <- count + 1
    let root = imp_sqrt[25.0, 0.0001]
    check_all[{
        check_eq[count, 5],
        check_eq[total, 32],
        check_true[abs[root - 5.0] < 0.001]
    }]

test_imp_for_to_downto[]: Result[Unit, String] ->
    var sum_up = 0
    for i = 1 to 10 do
        sum_up <- sum_up + i

    var seq_down = {}
    for j = 5 downto 1 do
        seq_down <- j :: seq_down

    var grid_sum = 0
    for r = 1 to 3 do
        for c = 1 to 2 do
            grid_sum <- grid_sum + (r * 10 + c)

    check_all[{
        check_eq[sum_up, 55],
        check_eq[seq_down, { 1, 2, 3, 4, 5 }],
        check_eq[grid_sum, 129]
    }]

test_imp_for_in[]: Result[Unit, String] ->
    let items = { 10, 20, 30, 40 }
    var sum_list = 0
    for x in items do
        sum_list <- sum_list + x

    var sum_range = 0
    for k in { 1 .. 5 } do
        sum_range <- sum_range + k

    var sum_step = 0
    for s in { 1 .. 2 .. 9 } do
        sum_step <- sum_step + s

    check_all[{
        check_eq[sum_list, 100],
        check_eq[sum_range, 15],
        check_eq[sum_step, 25]
    }]

test_imp_buffers[]: Result[Unit, String] ->
    let buf = __buffer_alloc[4]
    let _ = __buffer_set[buf, 0, 65]
    let _ = __buffer_set[buf, 1, 66]
    let _ = __buffer_set[buf, 2, 67]
    let _ = __buffer_set[buf, 3, 0]
    let len0 = __buffer_length[buf]
    let b0 = __buffer_get[buf, 0]
    let b2 = __buffer_get[buf, 2]
    let grown = __buffer_realloc[buf, 6]
    let len1 = __buffer_length[grown]
    let sbuf = __string_to_buffer["Liyh"]
    let slen = __buffer_length[sbuf]
    let roundtrip = __buffer_to_string[sbuf]
    check_all[{
        check_eq[len0, 4],
        check_eq[b0, 65],
        check_eq[b2, 67],
        check_eq[len1, 6],
        check_eq[__buffer_get[grown, 1], 66],
        check_eq[slen, 4],
        check_eq[roundtrip, "Liyh"]
    }]


test_imp_nested_early_exit_and_skip[]: Result[Unit, String] ->
    -- Note: Liyh has no break/continue keywords; emulate via guard flags and conditions.
    var found = -1
    var outer_iters = 0
    var i = 1
    while i <= 5 && found < 0 do
        outer_iters <- outer_iters + 1
        var j = 1
        var inner_stop = false
        while j <= 5 && not inner_stop do
            if (i * 10 + j) == 34 then
                found <- 34
                inner_stop <- true
            else
                j <- j + 1
        i <- i + 1

    var odd_sum = 0
    for k = 1 to 10 do
        if k % 2 != 0 then
            odd_sum <- odd_sum + k

    check_all[{
        check_eq[found, 34],
        check_eq[outer_iters, 3],
        check_eq[odd_sum, 25]
    }]

test_imp_loop_boundaries[]: Result[Unit, String] ->
    var eq_cnt = 0
    for i = 5 to 5 do
        eq_cnt <- eq_cnt + i

    var inv_to_cnt = 0
    for i = 5 to 2 do
        inv_to_cnt <- inv_to_cnt + 1

    var inv_down_cnt = 0
    for i = 2 downto 5 do
        inv_down_cnt <- inv_down_cnt + 1

    var neg_sum = 0
    for i = -3 to -1 do
        neg_sum <- neg_sum + i

    var empty_in = 0
    for x in {} do
        empty_in <- empty_in + x

    var single_in = 0
    for x in { 7 .. 7 } do
        single_in <- single_in + x

    var desc_in = {}
    for x in { 5 .. 1 } do
        desc_in <- x :: desc_in

    check_all[{
        check_eq[eq_cnt, 5],
        check_eq[inv_to_cnt, 0],
        check_eq[inv_down_cnt, 0],
        check_eq[neg_sum, -6],
        check_eq[empty_in, 0],
        check_eq[single_in, 7],
        check_eq[reverse[desc_in], { 5, 4, 3, 2, 1 }]
    }]


-- Test Registry --

imperative_tests[]: List[TestCase] ->
    {
        ("Imperative: var mutation & while loop (incl. Newton sqrt)", [] -> test_imp_var_and_while[]),
        ("Imperative: for..to, for..downto & nested loops", [] -> test_imp_for_to_downto[]),
        ("Imperative: for..in over lists & Int ranges", [] -> test_imp_for_in[]),
        ("Imperative: low-level __buffer_* alloc/get/set/realloc/string roundtrip", [] -> test_imp_buffers[]),
        ("Imperative: nested early-exit & conditional skip flags", [] -> test_imp_nested_early_exit_and_skip[]),
        ("Imperative: loop boundaries & degenerate step edge cases", [] -> test_imp_loop_boundaries[])
    }
